   "title": {
    "hi": "भौतिकी",
    "en": "Physics"
   },
   "concept": {
    "hi": "गति, प्रकाश, ध्वनि, विद्युत एवं चुंबकत्व के <mark>प्रमुख सूत्र व तथ्य</mark>। Group D में 25 विज्ञान प्रश्नों में भौतिकी का बड़ा हिस्सा होता है।",
    "en": "Key <mark>formulas & facts</mark>: motion, light, sound, electricity, magnetism."
   },
   "tricks": [
    {
     "h": {
      "hi": "गति के समीकरण",
      "en": "Equations of motion"
     },
     "b": {
      "hi": "<mark>v = u + at</mark> | <mark>s = ut + ½at²</mark> | <mark>v² = u² + 2as</mark>",
      "en": "<mark>v=u+at</mark> | <mark>s=ut+½at²</mark> | <mark>v²=u²+2as</mark>"
     }
    },
    {
     "h": {
      "hi": "न्यूटन के नियम",
      "en": "Newton's laws"
     },
     "b": {
      "hi": "1) जड़त्व 2) <mark>F = ma</mark> 3) क्रिया-प्रतिक्रिया। गुरुत्वीय त्वरण <mark>g = 9.8 m/s²</mark>।",
      "en": "1) Inertia 2) <mark>F=ma</mark> 3) Action-reaction. <mark>g=9.8 m/s²</mark>."
     }
    },
    {
     "h": {
      "hi": "कार्य, ऊर्जा, शक्ति",
      "en": "Work, energy, power"
     },
     "b": {
      "hi": "<mark>W = F×s</mark>; गतिज ऊर्जा <mark>½mv²</mark>; स्थितिज <mark>mgh</mark>; शक्ति <mark>P = W/t</mark>।",
      "en": "<mark>W=Fs</mark>; KE <mark>½mv²</mark>; PE <mark>mgh</mark>; <mark>P=W/t</mark>."
     }
    },
    {
     "h": {
      "hi": "प्रकाश",
      "en": "Light"
     },
     "b": {
      "hi": "प्रकाश की चाल <mark>3×10⁸ m/s</mark>। परावर्तन: आपतन कोण = परावर्तन कोण। अपवर्तनांक = <mark>c/v</mark>।",
      "en": "Speed <mark>3×10⁸ m/s</mark>. Angle of incidence = angle of reflection."
     }
    },
    {
     "h": {
      "hi": "ध्वनि",
      "en": "Sound"
     },
     "b": {
      "hi": "ध्वनि की चाल (वायु) ≈ <mark>332 m/s</mark>। आवृत्ति का मात्रक <mark>हर्ट्ज़ (Hz)</mark>। पराश्रव्य > 20,000 Hz।",
      "en": "Speed in air ≈ <mark>332 m/s</mark>. Unit: <mark>hertz</mark>."
     }
    },
    {
     "h": {
      "hi": "विद्युत",
      "en": "Electricity"
     },
     "b": {
      "hi": "ओम का नियम <mark>V = IR</mark>। शक्ति <mark>P = VI</mark>। घरों में <mark>220V, 50Hz</mark> AC।",
      "en": "Ohm's law <mark>V=IR</mark>. Power <mark>P=VI</mark>."
     }
    },
    {
     "h": {
      "hi": "चुंबकत्व",
      "en": "Magnetism"
     },
     "b": {
      "hi": "चुंबक के <mark>दो ध्रुव</mark> (उत्तर-दक्षिण)। समान ध्रुव प्रतिकर्षित, विपरीत आकर्षित।",
      "en": "Two poles; like repel, unlike attract."
     }
    },
    {
     "h": {
      "hi": "दाब एवं उत्प्लावन",
      "en": "Pressure & buoyancy"
     },
     "b": {
      "hi": "दाब <mark>P = F/A</mark>। आर्किमिडीज़: उत्प्लावन बल = हटाए गए द्रव का भार।",
      "en": "<mark>P=F/A</mark>. Archimedes' principle."
     }
    },
    {
     "h": {
      "hi": "तरंगदैर्घ्य",
      "en": "Wavelength"
     },
     "b": {
      "hi": "<mark>v = fλ</mark> (चाल = आवृत्ति × तरंगदैर्घ्य)।",
      "en": "<mark>v = fλ</mark>."
     }
    },
    {
     "h": {
      "hi": "लेंस/दर्पण",
      "en": "Lens/mirror"
     },
     "b": {
      "hi": "अवतल दर्पण <mark>अभिसारी</mark>; उत्तल दर्पण <mark>अपसारी</mark> (वाहनों में)।",
      "en": "Concave = <mark>converging</mark>; convex = <mark>diverging</mark>."
     }
    },
    {
     "h": {
      "hi": "ऊष्मा",
      "en": "Heat"
     },
     "b": {
      "hi": "विशिष्ट ऊष्मा का मात्रक <mark>J/kg·K</mark>। पानी की विशिष्ट ऊष्मा <mark>4200 J/kg·K</mark>।",
      "en": "Specific heat unit <mark>J/kg·K</mark>."
     }
    },
    {
     "h": {
      "hi": "मात्रक",
      "en": "Units"
     },
     "b": {
      "hi": "बल: <mark>न्यूटन</mark>; ऊर्जा: <mark>जूल</mark>; शक्ति: <mark>वाट</mark>; आवेश: <mark>कूलॉम</mark>।",
      "en": "Force: <mark>newton</mark>; energy: <mark>joule</mark>; power: <mark>watt</mark>."
     }
    },
    {
     "h": {
      "hi": "गुरुत्वाकर्षण",
      "en": "Gravitation"
     },
     "b": {
      "hi": "<mark>F = G·m₁m₂/r²</mark>। पृथ्वी पर भार = mg।",
      "en": "<mark>F=G·m₁m₂/r²</mark>. Weight = mg."
     }
    },
    {
     "h": {
      "hi": "सरल लोलक",
      "en": "Simple pendulum"
     },
     "b": {
      "hi": "आवर्तकाल <mark>T = 2π√(l/g)</mark> — लंबाई पर निर्भर, द्रव्यमान पर नहीं।",
      "en": "<mark>T=2π√(l/g)</mark> — depends on length."
     }
    },
    {
     "h": {
      "hi": "विद्युत धारा प्रभाव",
      "en": "Heating effect"
     },
     "b": {
      "hi": "जूल का नियम: <mark>H = I²Rt</mark> (हीटर, बल्ब)।",
      "en": "Joule's law: <mark>H=I²Rt</mark>."
     }
    }
   ],
   "examples": [],
   "mnemonics": [
