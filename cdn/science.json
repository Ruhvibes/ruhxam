   "title": {
    "hi": "रसायन विज्ञान",
    "en": "Chemistry"
   },
   "concept": {
    "hi": "परमाणु संरचना, आवर्त सारणी, अम्ल-क्षार, धातु-अधातु के <mark>प्रमुख तथ्य</mark>।",
    "en": "Key <mark>facts</mark>: atomic structure, periodic table, acids-bases, metals."
   },
   "tricks": [
    {
     "h": {
      "hi": "परमाणु संरचना",
      "en": "Atomic structure"
     },
     "b": {
      "hi": "प्रोटॉन <mark>(+)</mark>, न्यूट्रॉन (उदासीन) नाभिक में; इलेक्ट्रॉन <mark>(−)</mark> कक्षाओं में। परमाणु संख्या = <mark>प्रोटॉनों की संख्या</mark>।",
      "en": "Protons <mark>(+)</mark>, neutrons in nucleus; electrons <mark>(−)</mark> in orbits."
     }
    },
    {
     "h": {
      "hi": "आवर्त सारणी",
      "en": "Periodic table"
     },
     "b": {
      "hi": "आधुनिक सारणी <mark>मेंडेलीव</mark> ने नहीं, <mark>मोज़ले</mark> के नियम (परमाणु संख्या) पर आधारित। 7 आवर्त, 18 वर्ग।",
      "en": "Based on <mark>atomic number</mark> (Moseley). 7 periods, 18 groups."
     }
    },
    {
     "h": {
      "hi": "अम्ल-क्षार",
      "en": "Acids-bases"
     },
     "b": {
      "hi": "pH < 7 अम्ल, pH > 7 क्षार, <mark>pH = 7 उदासीन</mark>। लिटमस: अम्ल → लाल, क्षार → नीला।",
      "en": "pH<7 acid, pH>7 base, <mark>pH=7 neutral</mark>."
     }
    },
    {
     "h": {
      "hi": "धातु-अधातु",
      "en": "Metals-nonmetals"
     },
     "b": {
      "hi": "सबसे हल्की धातु <mark>लिथियम</mark>; सर्वाधिक तन्य <mark>सोना</mark>; द्रव धातु <mark>पारा</mark>; द्रव अधातु <mark>ब्रोमीन</mark>।",
      "en": "Lightest metal <mark>lithium</mark>; liquid metal <mark>mercury</mark>."
     }
    },
    {
     "h": {
      "hi": "गैसें",
      "en": "Gases"
     },
     "b": {
      "hi": "वायु में नाइट्रोजन <mark>78%</mark>, ऑक्सीजन <mark>21%</mark>। हँसाने वाली गैस <mark>N₂O</mark>।",
      "en": "Air: N₂ <mark>78%</mark>, O₂ <mark>21%</mark>. Laughing gas <mark>N₂O</mark>."
     }
    },
    {
     "h": {
      "hi": "रासायनिक सूत्र",
      "en": "Formulas"
     },
     "b": {
      "hi": "जल <mark>H₂O</mark>; नमक <mark>NaCl</mark>; बेकिंग सोडा <mark>NaHCO₃</mark>; चूना <mark>CaO</mark>।",
      "en": "Water <mark>H₂O</mark>; salt <mark>NaCl</mark>; baking soda <mark>NaHCO₃</mark>."
     }
    },
    {
     "h": {
      "hi": "संक्षारण",
      "en": "Corrosion"
     },
     "b": {
      "hi": "लोहे पर जंग = <mark>ऑक्सीकरण</mark>। रोकथाम: पेंट, गैल्वेनीकरण (जस्ता)।",
      "en": "Rusting = <mark>oxidation</mark>."
     }
    },
    {
     "h": {
      "hi": "कार्बन",
      "en": "Carbon"
     },
     "b": {
      "hi": "कार्बन के अपररूप: <mark>हीरा, ग्रेफाइट</mark>। हीरा सबसे कठोर प्राकृतिक पदार्थ।",
      "en": "Allotropes: <mark>diamond, graphite</mark>."
     }
    },
    {
     "h": {
      "hi": "pH मान",
      "en": "pH values"
     },
     "b": {
      "hi": "मानव रक्त <mark>7.4</mark>; नींबू रस ~2; शुद्ध जल 7।",
      "en": "Blood <mark>7.4</mark>; lemon ~2."
     }
    },
    {
     "h": {
      "hi": "धातुओं की अभिक्रियाशीलता",
      "en": "Reactivity series"
     },
     "b": {
      "hi": "<mark>K > Na > Ca > Mg > Al > Zn > Fe > Pb > Cu > Ag > Au</mark> (अधिक → कम)।",
      "en": "<mark>K>Na>Ca>Mg>Al>Zn>Fe>Pb>Cu>Ag>Au</mark>."
     }
    },
    {
     "h": {
      "hi": "मिश्रधातु",
      "en": "Alloys"
     },
     "b": {
      "hi": "पीतल = <mark>ताँबा+जस्ता</mark>; काँसा = <mark>ताँबा+टिन</mark>; स्टील = <mark>लोहा+कार्बन</mark>।",
      "en": "Brass = <mark>Cu+Zn</mark>; bronze = <mark>Cu+Sn</mark>."
     }
    },
    {
     "h": {
      "hi": "रेडियोधर्मिता",
      "en": "Radioactivity"
     },
     "b": {
      "hi": "खोज: <mark>बेकुरेल</mark>। α, β, γ किरणें (भेदन क्षमता γ सर्वाधिक)।",
      "en": "Discovered by <mark>Becquerel</mark>."
     }
    },
    {
     "h": {
      "hi": "ईंधन",
      "en": "Fuels"
     },
     "b": {
      "hi": "LPG = <mark>ब्यूटेन+प्रोपेन</mark>; CNG = <mark>मीथेन</mark>; बायोगैस = <mark>मीथेन</mark>।",
      "en": "LPG = <mark>butane+propane</mark>; CNG = <mark>methane</mark>."
     }
    },
    {
     "h": {
      "hi": "विलयन",
      "en": "Solutions"
     },
     "b": {
      "hi": "विलेय + विलायक = विलयन। संतृप्त विलयन में और विलेय <mark>नहीं घुलता</mark>।",
      "en": "Solute + solvent = solution."
     }
    },
    {
     "h": {
      "hi": "ऑक्सीकरण-अपचयन",
      "en": "Redox"
     },
     "b": {
      "hi": "ऑक्सीकरण = <mark>इलेक्ट्रॉन त्यागना</mark>; अपचयन = ग्रहण करना।",
      "en": "Oxidation = <mark>loss of electrons</mark>."
     }
    }
   ],
   "examples": [],
   "mnemonics": [
